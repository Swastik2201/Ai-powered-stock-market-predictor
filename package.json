{
  "name": "ai-powered-stock-market-predictor",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Financial & Stock Market Predictor Monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "cd apps/web && npx next dev -p 3000",
    "dev:web": "cd apps/web && npx next dev -p 3000",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload --port 8000",
    "build:web": "cd apps/web && npx next build",
    "lint:web": "cd apps/web && npx next lint",
    "type-check:web": "cd apps/web && npx tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0"
  },
  "keywords": [
    "fintech",
    "ai",
    "stock-market",
    "nextjs",
    "fastapi",
    "supabase",
    "prophet",
    "langchain"
  ],
  "author": "",
  "license": "MIT"
}
