{
  "name": "ai-powered-stock-market-predictor",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Financial & Stock Market Predictor Monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload --port 8000",
    "build:web": "npm run build --workspace=apps/web",
    "lint:web": "npm run lint --workspace=apps/web",
    "type-check:web": "npm run type-check --workspace=apps/web"
  },
  "keywords": [
    "fintech",
    "ai",
    "stock-market",
    "nextjs",
    "fastapi",
    "supabase",
    "prophet",
    "langchain"
  ],
