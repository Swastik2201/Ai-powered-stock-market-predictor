# ==========================================
# AI Financial App - Environment Configuration
# ==========================================

# ------------------------------------------
# Frontend Environment Variables (apps/web)
# ------------------------------------------
# Supabase URL for client authentication and database access
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co

# Supabase Anon Key for client side requests
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# API Backend Base URL (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------
# Backend Environment Variables (apps/api)
# ------------------------------------------
# Google Gemini API key for AI Copilot / Genius Service
GEMINI_API_KEY=your-google-gemini-api-key

# Supabase Project URL for server-side verification and integration
SUPABASE_URL=https://your-supabase-project.supabase.co

# Supabase Anon Key for server-side requests
SUPABASE_ANON_KEY=your-supabase-anon-key

# Direct PostgreSQL Database connection string (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Server Host & Port settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
